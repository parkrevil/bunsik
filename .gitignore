# ── 의존성 ──────────────────────────────────────────────
node_modules/

# ── 빌드 산출물 ─────────────────────────────────────────
dist/
.next/
/apps/*/out/
*.tsbuildinfo

# Next.js가 매 실행마다 재생성
next-env.d.ts

# ── 테스트 ──────────────────────────────────────────────
coverage/
*.lcov

# ── 환경 변수 (커밋 금지) ───────────────────────────────
.env
.env.*
!.env.example

# ── Bazel ───────────────────────────────────────────────
# 워크스페이스 루트의 편의 심볼릭 링크.
# 중첩 워크스페이스(tools/rules_bun, e2e/*)에도 생기므로 앵커하지 않는다.
bazel-*
# 개발자별 로컬 설정
/local.bazelrc

# ── 로컬 도구 설정 ──────────────────────────────────────
.claude/worktrees/
.claude/settings.local.json
.vscode/
.idea/

# ── OS / 로그 ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
