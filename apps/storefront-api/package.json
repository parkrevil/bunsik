{
  "name": "storefront-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun --bun --watch src/main.ts",
    "build": "bun build src/main.ts --compile --bytecode --format=esm --minify-whitespace --minify-syntax --sourcemap=inline --no-compile-autoload-bunfig --no-compile-autoload-dotenv --target bun --outfile dist/server",
    "start": "./dist/server",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ test/",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:cov": "bun test src --coverage",
    "test:e2e": "bun test test",
    "test:all": "bun test src test"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@nestjs/core@12.0.1": "patches/@nestjs%2Fcore@12.0.1.patch",
    "@nestjs/common@12.0.1": "patches/@nestjs%2Fcommon@12.0.1.patch"
  }
}
