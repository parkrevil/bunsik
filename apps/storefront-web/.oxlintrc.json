{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["node_modules", ".next", "out", "next-env.d.ts"]
}
