"""rules_bun — Bun 을 1급 툴체인으로 쓰는 Bazel 룰셋."""

module(
    name = "rules_bun",
    # README 가 요구하는 최소 버전을 실제로 강제한다.
    bazel_compatibility = [">=9.2.0"],
    # 버전은 비워 둔다. 비레지스트리 override 로 쓸 때 문제를 막는다.
    # (bazel-contrib/rules-template 의 주석 참조)
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# 문서 생성 전용. 소비자에게 전파되지 않는다.
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)

####### Dev dependencies ########
#
# 이 룰셋 자체의 테스트를 위한 툴체인이다. `dev_dependency = True` 는 이
# 모듈이 **루트일 때만** 적용되므로 소비자에게 전파되지 않는다. 즉 소비자는
# 자기 버전을 그대로 선언할 수 있다.
#
# 이게 없으면 툴체인이 필요한 테스트를 룰셋 워크스페이스에서 인스턴스화할
# 수 없어 TDD 의 red 를 여기서 볼 수 없다.
# 선례: aspect-build/rules_js 의 MODULE.bazel.

bun_dev = use_extension("//bun:extensions.bzl", "bun", dev_dependency = True)
bun_dev.toolchain(bun_version = "1.4.2")
use_repo(bun_dev, "bun_toolchains")

register_toolchains(
    "@bun_toolchains//:all",
    dev_dependency = True,
)
