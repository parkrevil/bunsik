# 호스트에 맞는 build:linux / build:macos / build:windows 블록을 자동 적용
common --enable_platform_specific_config

# 실패한 테스트의 로그를 콘솔에 출력
test --test_output=errors

# 액션 환경을 호스트에서 격리한다. 액션이 읽는 환경변수를 명시적으로만
# 허용해 "내 머신에서만 되는" 빌드를 막는다.
build --incompatible_strict_action_env

# 개발자별 로컬 설정 (커밋하지 않음)
try-import %workspace%/local.bazelrc
